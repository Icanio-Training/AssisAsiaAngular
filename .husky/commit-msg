# Conventional Commits: type(scope): subject — e.g. feat(initiatives): add chart drill-down
node -e "const m=require('fs').readFileSync(process.argv[1],'utf8');if(!/^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?!?: .+/.test(m)){console.error('Commit message must follow Conventional Commits, e.g. feat(auth): add refresh token');process.exit(1)}" "$1"
