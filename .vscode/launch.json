{
  // Run and Debug panel (Ctrl+Shift+D). Breakpoints set in VS Code .ts files are hit in Chrome
  // thanks to source maps (enabled in the development build configuration).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve + Chrome",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: start",
      "url": "http://localhost:4200/",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Attach to running Chrome (port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Debug unit tests (Vitest)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["ng", "test", "--watch=false"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
